# Workers assets revalidate HTML and other unversioned files by default.
# These patterns match Vite's fingerprinted output, not unversioned public assets.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache
