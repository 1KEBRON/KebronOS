// kebronze.com: the static build (dist/) served as Cloudflare Workers static assets.
// Deploy: npx vite build && npx wrangler deploy
{
  "name": "kebronos",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kebronze.com", "custom_domain": true }]
}
